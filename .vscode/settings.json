{
  "statusbar_command.commands": [
    {
      "text": "🟢 Backend",
      "tooltip": "Start backend server",
      "command": "extension.multiCommand.execute",
      "arguments": [
        {
          "command": "multiCommand.startBackend"
        }
      ]
    },
    {
      "text": "🛑 Stop Backend",
      "tooltip": "Stop backend (sends Ctrl+C to active terminal)",
      "command": "extension.multiCommand.execute",
      "arguments": [
        {
          "command": "multiCommand.stopBackend"
        }
      ]
    },
    {
      "text": "🔵 Frontend",
      "tooltip": "Start frontend web",
      "command": "extension.multiCommand.execute",
      "arguments": [
        {
          "command": "multiCommand.startFrontend"
        }
      ]
    },
    {
      "text": "🛑 Stop Frontend",
      "tooltip": "Stop frontend (sends Ctrl+C to active terminal)",
      "command": "extension.multiCommand.execute",
      "arguments": [
        {
          "command": "multiCommand.stopFrontend"
        }
      ]
    }
  ],
  "multiCommand.commands": [
    {
      "command": "multiCommand.startBackend",
      "sequence": [
        {
          "command": "workbench.action.terminal.newWithCwd",
          "args": {
            "cwd": "${workspaceFolder}/php-api"
          }
        },
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "php -S localhost:8080 router.php\n"
          }
        }
      ]
    },
    {
      "command": "multiCommand.stopBackend",
      "sequence": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "\u0003"
          }
        }
      ]
    },
    {
      "command": "multiCommand.startFrontend",
      "sequence": [
        {
          "command": "workbench.action.terminal.newWithCwd",
          "args": {
            "cwd": "${workspaceFolder}/web"
          }
        },
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "npm install\n"
          }
        },
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "npm run dev\n"
          }
        }
      ]
    },
    {
      "command": "multiCommand.stopFrontend",
      "sequence": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "\u0003"
          }
        }
      ]
    }
  ]
}
