{
  "statusbar_command.commands": [
    {
      "text": "🟢 Backend",
      "tooltip": "Start backend server",
      "command": "extension.multiCommand.execute",
      "arguments": [
        {
          "command": "multiCommand.startBackend"
        }
      ]
    },
    {
      "text": "🛑 Stop Backend",
      "tooltip": "Stop the Share Monitor backend task",
      "command": "extension.multiCommand.execute",
      "arguments": [
        {
          "command": "multiCommand.stopBackend"
        }
      ]
    },
    {
      "text": "🔵 Frontend",
      "tooltip": "Start frontend web",
      "command": "extension.multiCommand.execute",
      "arguments": [
        {
          "command": "multiCommand.startFrontend"
        }
      ]
    },
    {
      "text": "🛑 Stop Frontend",
      "tooltip": "Stop the Share Monitor frontend task",
      "command": "extension.multiCommand.execute",
      "arguments": [
        {
          "command": "multiCommand.stopFrontend"
        }
      ]
    }
  ],
  "multiCommand.commands": [
    {
      "command": "multiCommand.startBackend",
      "sequence": [
        {
          "command": "workbench.action.tasks.runTask",
          "args": "Share Monitor: Backend"
        }
      ]
    },
    {
      "command": "multiCommand.stopBackend",
      "sequence": [
        {
          "command": "workbench.action.tasks.terminate",
          "args": "Share Monitor: Backend"
        }
      ]
    },
    {
      "command": "multiCommand.startFrontend",
      "sequence": [
        {
          "command": "workbench.action.tasks.runTask",
          "args": "Share Monitor: Frontend"
        }
      ]
    },
    {
      "command": "multiCommand.stopFrontend",
      "sequence": [
        {
          "command": "workbench.action.tasks.terminate",
          "args": "Share Monitor: Frontend"
        }
      ]
    }
  ]
}
